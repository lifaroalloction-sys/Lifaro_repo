{
  "name": "journeyframes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/dist/index.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
